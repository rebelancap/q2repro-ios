# Local game data working copy (never commit — large, and user-owned)
/work/*
# ...except the PROVENANCE files. (The rule above is `/work/*`, not `/work/`, precisely so
# this negation can work: git never descends into an ignored DIRECTORY, so a rule that
# excludes work/ itself makes any un-ignore inside it unreachable.) Disk hygiene: anything large should
# to record where it came from and how to re-fetch it in work/<name>-PROVENANCE.md — and
# that record is only useful if it OUTLIVES the bytes it describes. Tracking it is what
# makes work/ safe to delete.
!/work/*-PROVENANCE.md

# Build outputs
/oracle/build-*/
/spikes/**/build/
/spikes/**/build-sim/
/spikes/**/DerivedData/
# xcodebuild output (derivedDataPath dirs: build-angle, build-visionos, build-rel, …) — rebuildable
/build-*/
/app/build-*/

# Vendored upstream working trees — reconstructed by scripts/bootstrap.sh (pinned clones with
# their own .git). NOT committed: pins live in bootstrap.sh; q2repro's local changes live in
# overlay/patches/; aq2-tng is used unmodified.
/vendor/q2repro/
/vendor/aq2-tng/

# Root/app build dir (xcodebuild default 'build') + PPM capture artifacts
/build/
/app/build/
/artifacts/**/*.ppm
/artifacts/*.ppm
# Huge throwaway checkouts (16GB+ ANGLE source, depot_tools) — rebuildable, never commit
/spikes/angle/
/spikes/depot_tools/
# Generated Xcode projects (regenerated by xcodegen from project.yml)
*.xcodeproj/
*.o
*.a
*.dylib

# Captured artifacts (screenshots, traces, logs) — keep the dir, ignore heavy contents
/artifacts/*.mov
/artifacts/*.mp4
/artifacts/*.trace
/artifacts/*.png
/artifacts/*.log

# macOS
.DS_Store

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# Scratch screenshots / temp
/tmp/
# OTA serving dir: manifests/index are committed for provenance; the IPAs are
# large, reproducible from the tagged commit, and re-staged by publish-ota.sh
/ota/q2repro/*.ipa

# ---- public-repo exclusions (dev-process docs + personal infra; guide §1) ----
CLAUDE.md
DECISIONS.md
MEASUREMENTS.md
QUESTIONS.md
*-FROM-VKQUAKE.md
*-CONSULT.md
FABLE_3D*.md
docs/PORT-NOTES.md
docs/visionos-3d-plan.md
docs/visionos-3d-integration.md
docs/phase1-plan.md
# personal OTA/signing/deploy infra (tailnet host, ASC key IDs, device UUIDs)
scripts/publish-ota.sh
scripts/deploy.sh
/ota/
# dev measurement captures + scratch
/artifacts/
/tmp/

# VR dev docs — local-only, never on public main (guide §17.2)
/docs/VR-*.md
/VR-PORTING-FROM-VKQUAKE.md

# Composite readbacks are large and regenerated by scripts/sim-verify-vr.sh;
# the committed evidence is the downscaled PNG beside them.
artifacts/**/*.ppm
