Subject: [overlay 0005] Route engine console output to stderr on iOS

With USE_SYSCON off, Sys_ConsoleOutput is macro-stubbed to (void)0, discarding all
Com_Printf output. On Apple iOS, declare it as a real function (the app implements it,
writing to stderr) so the engine boot log is visible via devicectl --console.
Apply: patch -p1 -d vendor/q2repro < this

diff --git a/inc/system/system.h b/inc/system/system.h
index 259f379f..47851b66 100644
--- a/inc/system/system.h
+++ b/inc/system/system.h
@@ -50,7 +50,14 @@ void    Sys_LoadHistory(void);
 void    Sys_SaveHistory(void);
 #else
 #define Sys_RunConsole()                (void)0
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+void    Sys_ConsoleOutput(const char *text, size_t len);   // iOS app routes to stderr (captured by devicectl)
+#else
 #define Sys_ConsoleOutput(text, len)    (void)0
+#endif
 #define Sys_SetConsoleTitle(title)      (void)0
 #define Sys_SetConsoleColor(color)      (void)0
 #define Sys_LoadHistory()               (void)0
