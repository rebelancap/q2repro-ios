Subject: [overlay 0006] Route statically-linked game modules on iOS (rerelease + Action)

iOS forbids dlopen of app-external code, so game modules are static libs linked into
the app. In SV_InitGameProgs, skip GameDll_Load/dlsym on Apple iOS and call the right
statically-linked entry directly: fs_game==action -> GetGameAPI_action (Action Quake,
classic API via GetGame3Proxy); else GetGameAPI (rerelease KEX). Apply: patch -p1 -d vendor/q2repro < this

diff --git a/src/server/game.c b/src/server/game.c
index 5dbae7c9..c0e8ffa1 100644
--- a/src/server/game.c
+++ b/src/server/game.c
@@ -18,6 +18,9 @@ with this program; if not, write to the Free Software Foundation, Inc.,
 // sv_game.c -- interface to the game dll
 
 #include "server.h"
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
 #include "game3_proxy/game3_proxy.h"
 #include "common/loc.h"
 #include "common/gamedll.h"
@@ -1094,9 +1097,21 @@ void SV_InitGameProgs(void)
     // unload anything we have now
     SV_ShutdownGameProgs();
 
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    // iOS: game modules are statically linked into the app (no dlopen of app-external
+    // code). Route to the right module by the active mod dir: "action" → Action Quake
+    // (classic API, via GetGame3Proxy); everything else → the rerelease KEX game.
+    extern void *GetGameAPI(void *import);          // rerelease (KEX, current API)
+    extern void *GetGameAPI_action(void *import);   // Action Quake (classic API v3)
+    if (fs_game && !Q_stricmp(fs_game->string, "action"))
+        entry = (game_entry_t)GetGameAPI_action;
+    else
+        entry = (game_entry_t)GetGameAPI;
+#else
     game_library = GameDll_Load();
     if (game_library)
         entry = Sys_GetProcAddress(game_library, "GetGameAPI");
+#endif
     if (!entry)
         Com_Error(ERR_DROP, "Failed to load game library");
 
@@ -1114,7 +1129,11 @@ void SV_InitGameProgs(void)
     Com_DPrintf("Game API version: %d\n", ge->apiversion);
 
     // get extended api if present
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    void* entry_ex = NULL;   // vanilla static game has no GetGameAPIEx
+#else
     void* entry_ex = Sys_GetProcAddress(game_library, "GetGameAPIEx");
+#endif
 
     if (ge->apiversion != GAME_API_VERSION) {
         if (ge->apiversion == GAME3_API_VERSION_OLD || ge->apiversion == GAME3_API_VERSION_NEW) {
