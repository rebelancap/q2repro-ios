+static vec2_t    cl_analog_move;   // analog move axis [-1,1] from touch/controller
+void CL_SetAnalogMove(float forward, float side) { cl_analog_move[0] = forward; cl_analog_move[1] = side; }
+
+// [iOS overlay] Touch/gyro look arrives as ABSOLUTE view-angle degrees (already scaled
+// by the app), added straight to the view — bypassing the engine `sensitivity`/m_accel
+// mouse path so touch feel is controlled solely by ios_sens_*. Controller stick look
+// arrives as a rate fraction. Both also drive the weapon wheel when it is open.
+static vec2_t    cl_ios_look_delta;    // yaw/pitch degrees (touch, gyro)
+static vec2_t    cl_ios_look_analog;   // yaw/pitch rate -1..1 (stick), pre-scaled by sens
+void CL_iOS_LookDelta(float yaw, float pitch)  { cl_ios_look_delta[0] += yaw; cl_ios_look_delta[1] += pitch; }
+void CL_iOS_LookAnalog(float yaw, float pitch) { cl_ios_look_analog[0] = yaw; cl_ios_look_analog[1] = pitch; }
+
+// [iOS overlay] Touch weapon wheel: set the cursor to an ABSOLUTE position (the finger's
+// offset from screen centre, in device px) so it follows the finger — unlike the controller
+// stick, which slams to the rim by direction (WHEEL_OPEN branch in CL_AdjustAngles). The
+// engine clamps the position to the wheel radius, so reaching the rim still selects.
+void CL_iOS_WheelCursor(float x, float y)
+{
+    if (cl.wheel.state == WHEEL_OPEN)
+        CL_Wheel_Input((int)(x - cl.wheel.position[0]), (int)(y - cl.wheel.position[1]));
+}
+
+// [iOS overlay] attract-mode state for the boot sequence: 0 interactive, 1 demo, 2 cinematic.
+int CL_iOS_PassiveState(void)
+{
+    if (cls.state == ca_cinematic) return 2;
+    if (cls.demo.playback) return 1;
+    return 0;
+}
+
+// [iOS overlay] true when no server/demo/cinematic is active (attract loop can (re)start).
+int CL_iOS_Disconnected(void)
+{
+    return cls.state == ca_disconnected;
+}
+
+// [iOS overlay] true while the game is showing a full-screen layout/menu (e.g. Action's
+// join-team / loadout PMenu, or the scoreboard) — so the touch layer can show menu-nav keys.
+int CL_iOS_LayoutActive(void)
+{
+    return cls.state == ca_active &&
+           (cl.frame.ps.stats[STAT_LAYOUTS] & (LAYOUTS_LAYOUT | LAYOUTS_INVENTORY)) != 0;
+}
