+// iOS/visionOS master mix gain, driven by app/Sources/ios_audio.m ("Game Volume"
+// plus the "Lower/Mute Game Audio" other-app modes). Deliberately NOT a cvar:
+// volume/s_volume are CVAR_ARCHIVE, so a ducked value would be written to
+// config.cfg on resign-active and become the base volume at next launch — a
+// ratchet that walks the player's real volume down over days. It also has to sit
+// ON TOP of the engine cvars so the in-game Options sliders keep working.
+// Applied in TransferPaintBuffer, i.e. after the raw stream is mixed in, so one
+// multiply covers sound effects, ogg music and cinematic audio alike. Inert
+// (1.0) on every other platform.
+float           s_ext_gain = 1.0f;
+
+void S_SetExternalGain(float g)
+{
+    s_ext_gain = Q_clipf(g, 0.0f, 1.0f);
+}
 
