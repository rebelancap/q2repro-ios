+
+// [vr overlay] ---------------------------------------------------------------------
+// The whole VR delta, in ONE struct that the platform shell writes and the engine reads.
+// `active` is set only by a visionOS VR world frame; every other build (iOS, the macOS
+// oracle, the visionOS 2D window and 3D panel) leaves it zero and therefore takes byte-for-
+// byte the paths it takes today. Nothing here is a cvar: `cl_kickangles`, `cl_thirdperson`
+// and `gl_znear` are CVAR_CHEAT and are silently refused on a multiplayer server, so a VR
+// override expressed as a cvar write would work in single player and vanish online.
+//
+// Tangents are POSITIVE magnitudes of the per-eye frustum edges at unit distance, in the
+// compositor's own convention (x right, y up, z back): the frustum spans -tanL..+tanR
+// horizontally and -tanD..+tanU vertically. They come from the compositor per eye per frame
+// and are asymmetric in BOTH axes on real hardware.
+typedef struct {
+    int     active;             // 1 while a VR world frame is being set up/rendered
+    int     eye;                // 0 = left, 1 = right (diagnostics only)
+    float   tan_l, tan_r, tan_u, tan_d;   // this eye's frustum tangents
+    int     pose_valid;         // 0 = no head pose yet; the frame renders from the game view
+    int     yaw_relative;       // 1 = viewangles[YAW] is ADDED to the game's own view yaw
+    float   eyeofs[3];          // this eye's offset from the game view origin in HEAD-LOCAL
+                                // axes (forward, right, up), world units. The engine rotates
+                                // it by the finished view angles, which is the only place
+                                // those angles are known.
+    float   viewangles[3];      // head euler angles, degrees (pitch, yaw, roll); yaw is
+                                // relative to the game's view yaw when yaw_relative is set
+    float   vieworg[3];         // WRITTEN BY THE ENGINE: the origin the frame actually used
+    float   game_yaw;           // WRITTEN BY THE ENGINE: the game's own view yaw this frame
+    float   listener_axis[3][3];// forward/right/up for the audio listener, head-derived
+    int     listener_valid;
+    float   znear;              // VR near plane in world units (0 = use gl_znear)
+    float   zfar_used;          // WRITTEN BY THE ENGINE: the far plane the last frustum used
+} q2_vr_state_t;
 
+extern q2_vr_state_t q2vr;
