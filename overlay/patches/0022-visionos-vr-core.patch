 // ==============================================================================
 
+// [vr overlay] Culling planes from this eye's real tangents instead of half of a symmetric
+// FOV. The symmetric build is not merely imprecise in VR, it is WRONG: a Vision Pro eye
+// frustum is asymmetric and canted, and geometry the eye can see falls outside the
+// fov/2 cone — which is the hard black wedge past roughly 85 degrees that the donors
+// catalogued. Same planes, same consumers (GL_CullBox/Sphere/LocalBox and the BSP node
+// rejection in world.c); only their construction changes.
+//
+// Derivation: the right edge direction is F - L*tan_r (F forward, L left, U up), so the
+// right plane's inward normal is F*tan_r + L, normalised. The other three follow by sign.
+// With tan_l == tan_r == tan(fov_x/2) this reproduces the symmetric planes exactly.
+static void GL_SetupFrustumTangents(void)
+{
+    vec3_t forward;
+    cplane_t *p;
+    int i;
+    const float tl = q2vr.tan_l, tr = q2vr.tan_r, tu = q2vr.tan_u, td = q2vr.tan_d;
+
+    VectorScale(glr.viewaxis[0], tr, forward);
+    VectorAdd(forward, glr.viewaxis[1], glr.frustumPlanes[0].normal);
+
+    VectorScale(glr.viewaxis[0], tl, forward);
+    VectorSubtract(forward, glr.viewaxis[1], glr.frustumPlanes[1].normal);
+
+    VectorScale(glr.viewaxis[0], td, forward);
+    VectorAdd(forward, glr.viewaxis[2], glr.frustumPlanes[2].normal);
+
+    VectorScale(glr.viewaxis[0], tu, forward);
+    VectorSubtract(forward, glr.viewaxis[2], glr.frustumPlanes[3].normal);
+
+    for (i = 0, p = glr.frustumPlanes; i < 4; i++, p++) {
+        VectorNormalize(p->normal);
+        p->dist = DotProduct(glr.fd.vieworg, p->normal);
+        p->type = PLANE_NON_AXIAL;
+        SetPlaneSignbits(p);
+    }
+}
+
 static void GL_SetupFrustum(void)
 {
     vec_t angle, sf, cf;
     vec3_t forward, left, up;
     cplane_t *p;
     int i;
+
+    // [vr overlay] asymmetric per-eye frustum (see above)
+    if (q2vr.active && (q2vr.tan_l > 0 || q2vr.tan_r > 0)) {
+        GL_SetupFrustumTangents();
+        return;
+    }
 
     // right/left
     angle = DEG2RAD(glr.fd.fov_x / 2);
