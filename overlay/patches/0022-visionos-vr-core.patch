+// [vr overlay] The one VR state block. Defined here because common/math.c links into every
+// configuration (client, refresh, server, the macOS oracle), so client-side writers and
+// renderer-side readers share one instance without a new translation unit or meson entry.
+// Zero on every build that is not a visionOS VR world frame.
+q2_vr_state_t q2vr;
+
+// [vr overlay] Generalised frustum: the four edge TANGENTS instead of a symmetric fov pair.
+// Identical output to Matrix_Frustum when l == r == tan(fov_x/2) and u == d == tan(fov_y/2),
+// which is asserted by the VR contract dump rather than assumed. The off-centre slots
+// matrix[8] and matrix[9] have existed in this function forever and have always evaluated to
+// zero; VR is the first caller that makes them non-zero, so any downstream helper that
+// "knows" they are zero is a bug the moment VR runs (the donors lost a round to exactly that
+// class of half-correct Y flip). Nothing downstream of here in this engine touches them.
+void Matrix_FrustumTangents(float tan_l, float tan_r, float tan_u, float tan_d,
+                            float reflect_x, float znear, float zfar, float *matrix)
+{
+    float xmin = -tan_l * znear, xmax = tan_r * znear;
+    float ymin = -tan_d * znear, ymax = tan_u * znear;
+    float width = xmax - xmin;
+    float height = ymax - ymin;
+    float depth = zfar - znear;
+
+    matrix[0] = reflect_x * 2 * znear / width;
+    matrix[4] = 0;
+    matrix[8] = (xmax + xmin) / width;
+    matrix[12] = 0;
+
+    matrix[1] = 0;
+    matrix[5] = 2 * znear / height;
+    matrix[9] = (ymax + ymin) / height;
+    matrix[13] = 0;
+
+    matrix[2] = 0;
+    matrix[6] = 0;
+    matrix[10] = -(zfar + znear) / depth;
+    matrix[14] = -2 * zfar * znear / depth;
+
+    matrix[3] = 0;
+    matrix[7] = 0;
+    matrix[11] = -1;
+    matrix[15] = 0;
+}
+
 void Matrix_Frustum(float fov_x, float fov_y, float reflect_x, float znear, float zfar, float *matrix)
 {
     float xmin, xmax, ymin, ymax;
