+// [vr overlay R2] CEILING CLAMP for the raised VR camera.
+//
+// A player whose real eyes are above Quake's 46-unit eye constant renders from a camera that
+// sits ABOVE the player hull's own head (hull max z = 32), so a low corridor puts the eye
+// inside a brush and the world renders from inside solid. Trace up each frame and clamp.
+//
+// The asymmetry is the whole point (guide 12.5): DUCK INSTANTLY, because a single frame
+// rendered from inside a wall is a visible defect; RISE BACK EASED at ~40 u/s, because a
+// camera that snaps upward is the one motion the head did not ask for.
+//
+// Called once per EYE but eased once per host FRAME: q2vr.eye is 0 for the left eye, and
+// advancing the ease twice per frame would double the rise rate on a whim of the render loop.
+#define VR_RISE_SPEED   40.0f       // units per second, upward only
+float CL_VR_ClampRise(const vec3_t org, float want)
+{
+    static float applied;
+    static unsigned last_ms;
+    vec3_t start, end, mins, maxs;
+    trace_t tr;
+    float allowed = want;
+
+    // A player SHORTER than the engine's 46-unit eye lowers the camera, and lowering can
+    // never put it inside the ceiling. Pass it straight through, unclamped and un-eased:
+    // there is nothing to trace against and nothing to ease towards.
+    if (want <= 0.0f) {
+        q2vr.rise_applied = want;
+        q2vr.rise_ducked = 0;
+        return want;
+    }
+
+    if (q2vr.ceiling_clamp && cl.bsp && cl.bsp->nodes && want > 0.0f) {
+        // A point trace with a small box, from the un-raised eye straight up. The player's
+        // own hull is not used: this is the CAMERA's clearance, and the camera is a point the
+        // player can put wherever their neck reaches.
+        VectorSet(mins, -2, -2, 0);
+        VectorSet(maxs,  2,  2, 0);
+        VectorCopy(org, start);
+        VectorCopy(org, end);
+        end[2] += want;
+        CL_LerpedTrace(&tr, start, end, mins, maxs, MASK_SOLID);
+        allowed = want * tr.fraction;
+        if (allowed < 0.0f)
+            allowed = 0.0f;
+    }
+
+    if (q2vr.eye == 0) {
+        unsigned now = cls.realtime;
+        float dt = last_ms ? (now - last_ms) * 0.001f : 0.0f;
+        last_ms = now;
+        if (dt < 0.0f || dt > 0.25f)
+            dt = 0.0f;                      // a load hitch is not a second of rising
+        if (allowed <= applied)
+            applied = allowed;              // duck: instantly
+        else
+            applied = min(allowed, applied + VR_RISE_SPEED * dt);   // rise: eased
     }
+
+    q2vr.rise_applied = applied;
+    q2vr.rise_ducked = (applied < want - 0.01f);
+    return applied;
 }
 
