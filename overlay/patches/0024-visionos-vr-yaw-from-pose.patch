     void  (*ui_begin)(void);    // bind the UI framebuffer (and clear it once per host frame)
     void  (*ui_end)(void);      // bind back to the eye framebuffer
+
+    // [vr overlay R3] THE YAW SEPARATION. APPENDED, never inserted, for the same reason the
+    // R2 block was: the shell and the engine agree on this struct only by layout.
+    //
+    // R2 composed the rendered yaw as "the head's pitch and roll, plus THE GAME'S OWN VIEW
+    // YAW" (`yaw_relative` added cl.refdef.viewangles[YAW]). That number is
+    // cl.predicted_angles — cl.viewangles plus the server's delta — and it is produced by the
+    // CLIENT SIMULATION, which does not run on every rendered frame. The head pose is fresh
+    // every frame; the yaw the frame was rendered with was one to two client ticks old and
+    // only advanced when the sim advanced. The compositor reprojects against the pose it
+    // PUBLISHED, so every frame whose yaw had not caught up was reprojected by the residual —
+    // and the residual is non-zero only while the head is turning. That is the "jitter in
+    // both eyes as I look left and right" of the first headset round, and nothing else: pitch
+    // and roll were always written straight from the pose and never shook.
+    //
+    // The fix is the donors' architecture (guide 12.7): the rendered yaw is body yaw + head
+    // yaw, both owned by the shell and both taken from the pair published THIS frame, and the
+    // only engine contribution is `server_yaw` — the server's own re-orientation, which is a
+    // STEP the server sets on a teleport or a spawn and never a predicted, lerped or
+    // smoothed quantity. `yaw_relative` now selects THAT term and no longer reads any
+    // client-simulated angle.
+    float   server_yaw;         // WRITTEN BY THE ENGINE: ps.pmove.delta_angles[YAW], the
+                                // server's own re-orientation. Added when yaw_relative is set.
+    float   render_yaw;         // WRITTEN BY THE ENGINE: the yaw the frame ACTUALLY rendered
+                                // with (identity, not intent — the dumps report this one)
+    int     yaw_from_pose;      // WRITTEN BY THE ENGINE: 1 when the rendered basis came from
+                                // the published pose. 0 means something upstream fell back,
+                                // and a dump that says 0 is the diagnosis, not a guess.
 } q2_vr_state_t;
 
