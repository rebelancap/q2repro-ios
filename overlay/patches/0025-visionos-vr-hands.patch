+    float   vm_ang[3];          // WRITTEN BY THE ENGINE: the angles it was mounted with
+    int     vm_mounted;         // WRITTEN BY THE ENGINE: 1 = mounted to the hand this frame
+    float   dot_range;          // WRITTEN BY THE ENGINE: how far the aim trace reached
+    int     dot_drawn;          // WRITTEN BY THE ENGINE: 1 = the dot was actually added
 } q2_vr_state_t;
 
