+    float   grip_ofs[3];        // grip offset along the hand's OWN forward/right/up, units
+    float   weapon_scale;       // Weapon Size row, 0.5 .. 2.0
+    int     aim_dot;            // 1 = draw the world-space aim dot along the hand ray
