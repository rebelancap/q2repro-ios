 //
 // Called once per EYE but eased once per host FRAME: q2vr.eye is 0 for the left eye, and
 // advancing the ease twice per frame would double the rise rate on a whim of the render loop.
+// [vr overlay R4] THE WORLD-SPACE AIM DOT.
+//
+// A FLAT crosshair fuses at no distance: each eye is told the reticle is at the screen while
+// the surface behind it is metres away, and the player's eyes are asked to converge on two
+// depths at once. So the dot is a WORLD POINT at the traced hit, and its depth cue is the
+// ordinary stereo parallax of a point at that range — nothing special is required of the
+// renderer to produce it.
+//
+// It goes through the PARTICLE pipeline, which already exists, is already additive when
+// `gl_partstyle` says so, already billboards to the view, and already grows its quad with
+// distance (`1 + dist*0.004` in tess.c) — which is very nearly constant angular size, i.e.
+// exactly the behaviour a reticle wants. Deliberately NOT a GL line beam: Metal has no wide
+// lines, so a line-mode beam is one aliased pixel at an eye's resolution, and it is the
+// feature both donors ended up deleting.
+//
+// The ray is `hand_ray_ang` — the UNGRIPPED hand direction — because the dot exists to tell
+// the player where the shot goes, and the grip calibration moves only the model. And the
+// ORIGIN is the eye, not the hand: the server's hitscan starts at the player's body, so a dot
+// drawn from the muzzle would confidently disagree with the bullet in the near field. That
+// parallax is a documented, accepted limitation of not moving the player edict server-side
+// (charter §1 OUT), and the honest thing is to show the same ray the server will trace.
+#define VR_DOT_RANGE 8192.0f
+void CL_VR_AddAimDot(void)
+{
+    particle_t p;
+    trace_t tr;
+    vec3_t start, end, f, r, u, mins, maxs;
+
+    q2vr.dot_drawn = 0;
+    q2vr.dot_range = 0.0f;
+    if (!q2vr.active || !q2vr.aim_dot || !q2vr.hand_valid)
+        return;
+    if (!cl.bsp || !cl.bsp->nodes)
+        return;
+
+    AngleVectors(q2vr.hand_ray_ang, f, r, u);
+    VectorCopy(cl.refdef.vieworg, start);
+    VectorMA(start, VR_DOT_RANGE, f, end);
+    VectorSet(mins, 0, 0, 0);
+    VectorSet(maxs, 0, 0, 0);
+    CL_LerpedTrace(&tr, start, end, mins, maxs, MASK_SOLID);
+    if (tr.startsolid || tr.allsolid)
+        return;
+
+    q2vr.dot_range = VR_DOT_RANGE * tr.fraction;
+    // Lift off the surface proportionally rather than by a fixed amount: collision geometry is
+    // chorded more coarsely than the drawn mesh, so a constant pull-back that hides the seam
+    // at ten metres floats visibly at one.
+    VectorMA(tr.endpos, -max(1.0f, q2vr.dot_range * 0.004f), f, p.origin);
+    p.color = -1;
+    p.rgba.u8[0] = 255;
+    p.rgba.u8[1] = tr.fraction >= 1.0f ? 150 : 235;   // a sky miss reads dimmer, on purpose
+    p.rgba.u8[2] = tr.fraction >= 1.0f ? 150 : 190;
+    p.rgba.u8[3] = 255;
+    p.alpha = 1.0f;
+    // The particle pipeline already scales with distance, so this is an angular size and not
+    // a world size; 1.0 is the shipped default and `q2vrdot <on> <scale>` tunes it live.
+    p.scale = q2vr.aim_dot_scale > 0.01f ? q2vr.aim_dot_scale : 1.0f;
+    V_AddParticle(&p);
+    q2vr.dot_drawn = 1;
+}
+
