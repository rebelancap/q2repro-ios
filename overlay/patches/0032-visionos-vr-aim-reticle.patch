+// [vr overlay R8] THE VR AIM RETICLE, and it has its own draw for a measured reason.
+//
+// It was a particle for three rounds and it was never seen once. The simulator settled
+// why: at `gl_partscale 200` the particle quad covers a third of the eye image, so it was
+// never depth-failing and never mispointed — but the sprite's peak contribution over the
+// background is only about a third of its own colour, and at eight times size it smears into
+// a sliver rather than growing into a mark. TEXNUM_PARTICLE is a soft radially-faded blob
+// designed to be one of hundreds in a spray; a reticle is one hard mark that has to be
+// legible alone. So this draws the reticle's own quads, with the WHITE texture, full alpha,
+// and the depth test off.
+//
+// Depth off is deliberate, not a shortcut: a crosshair hidden behind the player's own gun
+// barrel is a crosshair that is not doing its job, and every shipped VR reticle draws over
+// the scene. The stereo cue is unaffected — the points are still at the trace hit, so the
+// two eyes converge on the surface the player is aiming at, which is the whole reason this
+// is a world reticle and not a screen one.
+//
+// Drawn after GL_DrawParticles in R_RenderFrame, so it sits over the world and its effects
+// but under nothing that matters.
+void GL_DrawVRReticle(void)
+{
+    vec_t *dst;
+    color_t color;
+    int numverts, i;
+
+    if (!q2vr.active || !q2vr.dot_drawn || q2vr.dot_npts <= 0)
+        return;
+
+    GL_LoadMatrix(gl_identity, glr.viewmatrix);
+    GL_LoadUniforms();
+    GL_BindArrays(VA_EFFECT);
+    GL_BindTexture(TMU_TEXTURE, TEXNUM_WHITE);
+    GL_StateBits(GLS_BLEND_BLEND | GLS_DEPTHMASK_FALSE | GLS_DEPTHTEST_DISABLE);
+    GL_ArrayBits(GLA_VERTEX | GLA_TC | GLA_COLOR);
+
+    color.u8[0] = 255;
+    color.u8[1] = 240;
+    color.u8[2] = 205;
+    color.u8[3] = 255;
+
+    dst = tess.vertices;
+    numverts = 0;
+    for (i = 0; i < q2vr.dot_npts && i < 5; i++) {
+        vec3_t a, b, c, d, ro, uo;
+        int k;
+        const vec_t *o = q2vr.dot_pts[i];
+        float h = q2vr.dot_half[i];
+
+        if (h <= 0.0f)
+            continue;
+        if (numverts + 6 > TESS_MAX_VERTICES)
+            break;
+
+        VectorScale(glr.viewaxis[1], h, ro);
+        VectorScale(glr.viewaxis[2], h, uo);
+        VectorSubtract(o, ro, a); VectorSubtract(a, uo, a);   // -r -u
+        VectorAdd(o, ro, b);      VectorSubtract(b, uo, b);   // +r -u
+        VectorAdd(o, ro, c);      VectorAdd(c, uo, c);        // +r +u
+        VectorSubtract(o, ro, d); VectorAdd(d, uo, d);        // -r +u
+
+        {
+            const vec_t *quad[6] = { a, b, c, a, c, d };
+            for (k = 0; k < 6; k++) {
+                VectorCopy(quad[k], dst);
+                dst[3] = 0;
+                dst[4] = 0;
+                WN32(dst + 5, color.u32);
+                dst += 6;
+                numverts++;
+            }
+        }
+    }
+
+    if (!numverts)
+        return;
+
+    GL_LockArrays(numverts);
+    qglDrawArrays(GL_TRIANGLES, 0, numverts);
+    GL_UnlockArrays();
+}
