+// [iOS overlay 0038] ---- the VR wheel cursor -------------------------------------------------
+// The wheel is 100 % client-side: three producers already drive cl.wheel.position (the mouse,
+// the touch layer's absolute cursor, and the controller stick's slam-to-direction), and in a VR
+// world frame NONE of them runs — the Sense sticks go to the snap-turn snapshot and
+// CL_AdjustAngles is never reached. So the wheel opened, drew, holstered the gun and was inert.
+// These three exports are the fourth producer plus the two things the shell and the harness need
+// to read back. No game-code change: the wheel never leaves the client.
+
+// 0 = closed, 1 = the weapon wheel, 2 = the powerup / inventory wheel.
+int CL_iOS_WheelOpen(void)
+{
+    if (cl.wheel.state != WHEEL_OPEN)
+        return 0;
+    return cl.wheel.is_powerup_wheel ? 2 : 1;
+}
+
+// The slot under the cursor right now, or -1. Read by the VR shell so a selection CHANGE can be
+// felt in the hand — which is what makes a ring selectable without looking straight at it.
+int CL_iOS_WheelSelected(void)
+{
+    return cl.wheel.state == WHEEL_OPEN ? cl.wheel.selected : -1;
+}
+
+// The aim ray, as NORMALISED coordinates on the head-locked HUD quad: -1..1 left to right and
+// -1..1 top to bottom, over the quad's own extent. The shell intersects the aim hand's ray with
+// the quad the compositor placed and hands the result here, so this is a pure scale into the
+// wheel's pixel space followed by the SAME absolute-cursor trick CL_iOS_WheelCursor uses for a
+// finger. Returns 0 when no wheel is open, so the shell can skip the whole step.
+int CL_iOS_VRWheelCursorNDC(float u, float v)
+{
+    if (cl.wheel.state != WHEEL_OPEN)
+        return 0;
+
+    float hw = cl_ios_wheel_geo_ok ? cl_ios_wheel_geo[0] : (scr.hud_width  / scr.hud_scale) * 0.5f;
+    float hh = cl_ios_wheel_geo_ok ? cl_ios_wheel_geo[1] : (scr.hud_height / scr.hud_scale) * 0.5f;
+    float cx = cl_ios_wheel_geo_ok ? cl_ios_wheel_geo[2] : hw;
+    float cy = cl_ios_wheel_geo_ok ? cl_ios_wheel_geo[3] : hh;
+
+    // quad-relative pixels, then wheel-centre-relative pixels
+    float x = (u * hw + hw) - cx;
+    float y = (v * hh + hh) - cy;
+
+    CL_Wheel_Input((int)(x - cl.wheel.position[0]), (int)(y - cl.wheel.position[1]));
+    return 1;
+}
+
+// WHEELNOW's payload. The assertion channel for the suite: everything the selection depends on,
+// plus the active weapon, which is the only thing that proves the RELEASE confirmed.
+int CL_iOS_WheelDump(char *out, int n)
+{
+    int sel = (cl.wheel.state == WHEEL_OPEN) ? cl.wheel.selected : -1;
+    int item = (sel >= 0 && (size_t)sel < cl.wheel.num_slots) ? cl.wheel.slots[sel].item_index : -1;
+    int data = (sel >= 0 && (size_t)sel < cl.wheel.num_slots) ? cl.wheel.slots[sel].data_id : -1;
+    int owned = 0;
+
+    for (size_t i = 0; i < cl.wheel.num_slots; i++)
+        if (cl.wheel.slots[i].has_item)
+            owned++;
+
+    Q_snprintf(out, n,
+               "open=%d powerup=%d state=%d slots=%d owned=%d sel=%d item=%d dataid=%d dist=%.1f "
+               "pos=(%.1f,%.1f) dir=(%.3f,%.3f) slicesin=%.3f geo=%d halfw=%.1f halfh=%.1f "
+               "cx=%.1f cy=%.1f activeweap=%d timer=%.2f",
+               cl.wheel.state == WHEEL_OPEN ? 1 : 0,
+               cl.wheel.is_powerup_wheel ? 1 : 0,
+               (int)cl.wheel.state, (int)cl.wheel.num_slots, owned, sel, item, data,
+               cl.wheel.distance, cl.wheel.position[0], cl.wheel.position[1],
+               cl.wheel.dir[0], cl.wheel.dir[1], cl.wheel.slice_sin,
+               cl_ios_wheel_geo_ok, cl_ios_wheel_geo[0], cl_ios_wheel_geo[1],
+               cl_ios_wheel_geo[2], cl_ios_wheel_geo[3],
+               cl.frame.ps.stats[STAT_ACTIVE_WEAPON], cl.wheel.timer);
+    return cl.wheel.state == WHEEL_OPEN ? 1 : 0;
+}
