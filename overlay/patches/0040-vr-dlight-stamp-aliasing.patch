+
+// [vr overlay 0040] THE INSTRUMENT THAT CLOSED THE CASE, kept because it is the only way to
+// see this class of defect without a pixel harness. `gl_lightdiag 1` prints, once per world
+// render:
+//   LIGHTALIAS prestamped — how many faces ALREADY carry the stamp this render is about to
+//     use. The invariant is 0. Non-zero means the counter has wrapped onto a stamp a previous
+//     pass wrote and those faces smuggle that pass's dlightbits through the gate in tess.c.
+//   LIGHTDIAG lh — an ORDER-INDEPENDENT hash of the admitted dlight list, which separates a
+//     per-eye SELECTION difference (the 64-of-143 cap) from a per-eye MARKING difference.
+//   LIGHTDIAG bh/marked — the same for every world face's dlightbits after GL_MarkLights.
+// Identical lh with differing bh is the marking side; that is what base1 measured.
+static void GL_LightDiag(void)
+{
+    const bsp_t *bsp = gl_static.world.cache;
+    uint32_t lh = 0, bh = 0;
+    int marked = 0, i;
+
+    for (i = 0; i < glr.fd.num_dlights; i++) {
+        const dlight_t *dl = &glr.fd.dlights[i];
+        uint32_t h = 2166136261u;
+        h = (h * 16777619u) ^ (uint32_t)(int)(dl->origin[0] * 8.0f);
+        h = (h * 16777619u) ^ (uint32_t)(int)(dl->origin[1] * 8.0f);
+        h = (h * 16777619u) ^ (uint32_t)(int)(dl->origin[2] * 8.0f);
+        h = (h * 16777619u) ^ (uint32_t)(int)(dl->radius);
+        lh += h;    // commutative, so admission ORDER cannot change the hash
+    }
+
+    for (i = 0; i < bsp->numfaces; i++) {
+        const mface_t *f = &bsp->faces[i];
+        uint32_t h;
+        if (f->dlightframe != glr.dlightframe)
+            continue;
+        marked++;
+        h = 2166136261u ^ (uint32_t)i;
+        h = (h * 16777619u) ^ (uint32_t)(f->dlightbits & 0xffffffffu);
+        h = (h * 16777619u) ^ (uint32_t)(f->dlightbits >> 32);
+        bh += h;
     }
+
+    Com_Printf("LIGHTDIAG eye=%d rep=%d n=%d lh=%08x marked=%d bh=%08x org=%.2f,%.2f,%.2f\n",
+               q2vr.active ? q2vr.eye : -1, glr.repeat_frame ? 1 : 0,
+               glr.fd.num_dlights, lh, marked, bh,
+               glr.fd.vieworg[0], glr.fd.vieworg[1], glr.fd.vieworg[2]);
 }
 
