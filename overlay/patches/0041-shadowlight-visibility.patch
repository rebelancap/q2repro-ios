@@ -162,7 +170,84 @@
     {
         VectorMA(origin, size / (2.0f * c), forward, out);
         out[3]   = size / (2.0f * c);
+    }
+}
+
+// [vr overlay 0041] CLIENT-SIDE RELEVANCE CULL FOR SHADOW LIGHTS.
+//
+// With the server no longer PHS-culling RF_CASTSHADOW entities (see src/server/entities.c),
+// the client receives every shadow light on the map — base1 alone defines 143 of them against
+// a 64-slot MAX_DLIGHTS cap. Sending all of them into V_AddLightEx would just move the
+// arbitrary drop from the server to the eviction rescan. So cull here, on the question that
+// actually matters: does this light's VOLUME touch anything the viewer can see?
+//
+// A light is relevant iff its bounding sphere (the cone bounding sphere for a spot) touches at
+// least one leaf whose cluster is in the view leaf's PVS. That is stable under motion in a way
+// the PHS-of-the-light's-own-leaf test is not: the sphere spans the leaves the light lights, so
+// it stops being relevant only once its lit volume has left the potentially visible set.
+//
+// Conservative in every failure mode: no map, no vis data, or a view origin in solid (cluster
+// < 0) admits everything, and a light whose sphere overflows the leaf list is admitted too —
+// irrelevance must be PROVEN, never assumed.
+static visrow_t v_shadowvis;
+static bool     v_shadowvis_valid;
+
+void V_UpdateShadowLightVis(void)
+{
+    const bsp_t *bsp = cl.bsp;
+    const mleaf_t *leaf;
+
+    v_shadowvis_valid = false;
+
+    if (!bsp || !bsp->nodes || !bsp->vis)
+        return;     // no map or no vis -> everything is relevant
+
+    leaf = BSP_PointLeaf(bsp->nodes, cl.refdef.vieworg);
+    if (!leaf || leaf->cluster < 0)
+        return;     // in solid / outside the world -> everything is relevant
+
+    BSP_ClusterVis(bsp, &v_shadowvis, leaf->cluster, DVIS_PVS);
+    v_shadowvis_valid = true;
+}
+
+#define V_SHADOWLIGHT_MAX_LEAFS 128
+
+bool V_ShadowLightRelevant(const cl_shadow_light_t *light)
+{
+    const mleaf_t *leafs[V_SHADOWLIGHT_MAX_LEAFS];
+    vec4_t  sphere;
+    vec3_t  mins, maxs;
+    int     count, i;
+
+    if (!v_shadowvis_valid)
+        return true;
+
+    if (light->coneangle) {
+        float a = DEG2RAD(light->coneangle);
+        cone_to_bounding_sphere(light->origin, light->conedirection, light->radius,
+                                a, cosf(a), sinf(a), sphere);
+    } else {
+        VectorCopy(light->origin, sphere);
+        sphere[3] = light->radius;
     }
+
+    for (i = 0; i < 3; i++) {
+        mins[i] = sphere[i] - sphere[3];
+        maxs[i] = sphere[i] + sphere[3];
+    }
+
+    count = CM_BoxLeafs_headnode(mins, maxs, leafs, V_SHADOWLIGHT_MAX_LEAFS,
+                                 cl.bsp->nodes, NULL);
+    if (count >= V_SHADOWLIGHT_MAX_LEAFS)
+        return true;    // list overflowed: cannot prove irrelevance, so keep the light
+
+    for (i = 0; i < count; i++) {
+        int cluster = leafs[i]->cluster;
+        if (cluster >= 0 && Q_IsBitSet(v_shadowvis.b, cluster))
+            return true;
+    }
+
+    return false;
 }
 
