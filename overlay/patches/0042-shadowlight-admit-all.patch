+// [vr overlay 0042] how many r_dlights slots CL_AddShadowLights may still fill this frame
+// (MAX_DLIGHTS minus the lights already added minus a reserve). See view.c.
+int V_ShadowLightBudget(void);
 extern int r_shadowlight_evictions;
