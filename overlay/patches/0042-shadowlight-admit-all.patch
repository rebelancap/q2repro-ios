 void V_AddLightStyle(int style, float value);
--- a/src/client/view.c
+++ b/src/client/view.c
@@ -250,6 +250,31 @@
     return false;
 }
 
+// [vr overlay 0042] HOW MANY r_dlights SLOTS ARE STILL AVAILABLE TO SHADOW LIGHTS.
+//
+// CL_AddShadowLights needs this to decide whether it can admit every light the server sent
+// without culling anything (see effects.c). r_numdlights lives here, not in effects.c, and
+// so does the knowledge of who owns which slot — so the budget is computed here.
+//
+// The RESERVE. By the time CL_AddShadowLights runs, every transient effect light of the
+// frame is already in the array: CL_AddEntities calls CL_AddPacketEntities (muzzle flashes,
+// item glows, rocket/BFG trails), CL_AddTEnts (explosions) and CL_AddDLights (cl_dlights,
+// the timed ones) BEFORE it, so r_numdlights already counts them exactly. The reserve is
+// therefore not for them; it is for
+//   * LOC_AddLocationsToScene, the one V_AddLight caller that runs AFTER us (locs.c, under
+//     cl_drawlocs) — without a reserve its lights would be silently squeezed out, and
+//   * headroom against upstream drift, since a future stage added after CL_AddShadowLights
+//     would otherwise be starved by a full array with no diagnostic.
+// Eight slots is 12.5% of MAX_DLIGHTS, which base1's 37 shadow lights never come near, and
+// small enough that a map dense enough to need the cull path is the map that gets it.
+#define V_SHADOWLIGHT_RESERVE   8
+
+int V_ShadowLightBudget(void)
+{
+    int budget = MAX_DLIGHTS - r_numdlights - V_SHADOWLIGHT_RESERVE;
+    return max(budget, 0);
+}
