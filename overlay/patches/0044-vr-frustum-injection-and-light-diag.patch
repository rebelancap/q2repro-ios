+// [vr overlay 0044 — R20 DIAGNOSTIC ONLY] see the gl_vrtan0/1/cull block at the top.
+static void GL_InjectTangents(void)
+{
+    const char *s = (q2vr.eye & 1) ? gl_vrtan1->string : gl_vrtan0->string;
+    float t[4];
