+// [vr overlay 0045] The four UBO update modes, shared by the two per-batch UBOs. See the
+// gl_dlight_ubo block in main.c for why this is a variable at all. `ring` may be NULL for a
+// buffer that has no ring (it is then treated as mode 0/1/3).
+static void shader_upload_ubo(int mode, GLuint single, GLuint *ring, int *ring_i,
+                              GLuint base_index, GLsizeiptr size, const void *data)
+{
+    if (mode == 2 && ring && ring[0]) {
+        *ring_i = (*ring_i < 0) ? 0 : (*ring_i + 1) % UBO_RING_SIZE;
+        GLuint buf = ring[*ring_i];
+        GL_BindBuffer(GL_UNIFORM_BUFFER, buf);
+        qglBufferData(GL_UNIFORM_BUFFER, size, data, GL_DYNAMIC_DRAW);
+        // GL_BindBufferBase always calls through (gl.h caches, but never elides the base
+        // bind), so the rebind cannot be dropped — that would leave the previous ring entry
+        // bound and make the whole experiment a no-op.
+        GL_BindBufferBase(GL_UNIFORM_BUFFER, base_index, buf);
+        return;
+    }
 
+    // Leaving ring mode has to put the ORIGINAL buffer back on the binding point, or every
+    // later upload writes a buffer nothing reads and the shader keeps sampling the last ring
+    // entry — a frozen light set that looks exactly like a fix. (This bit the first run of
+    // the experiment: every row after the first ring row was measuring stale lights.)
+    if (ring && ring[0] && *ring_i >= 0) {
+        GL_BindBufferBase(GL_UNIFORM_BUFFER, base_index, single);
+        *ring_i = -1;
+    }
+
+    GL_BindBuffer(GL_UNIFORM_BUFFER, single);
+    if (mode == 1)
+        qglBufferData(GL_UNIFORM_BUFFER, size, NULL, GL_DYNAMIC_DRAW);
+    qglBufferSubData(GL_UNIFORM_BUFFER, 0, size, data);
+    if (mode == 3)
+        qglFinish();
+}
